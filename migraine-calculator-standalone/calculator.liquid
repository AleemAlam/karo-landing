{% comment %} ============================================================
     STYLES - Matching MigraineCostCalculator.tsx exactly
     ============================================================ {% endcomment %}

{% style %}
  /* === BASE STYLES === */

  input{
    padding: 8px 12px !important;
  }

  #migraine-container{
    background-color: #f5f3f0;
  }

  #migraine-calculator {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #111827;
    line-height: 1.5;
    width: 100%;
    max-width: 1640px;
    margin: auto;
    background-color: #f5f3f0;
  }

  #migraine-calculator * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* === SECTION 1: HEAD & HEADING === */
  
  /* Section Container: py-20 bg-[#f5f3f0] lg:mx-20 */
  .mc-section {
    padding: 80px 16px;
  }

  @media (min-width: 1024px) {
    .mc-section {
      margin-left: 80px;
      margin-right: 80px;
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  /* Inner Container: max-w-[1480px] mx-auto px-4 lg:px-6 */
  .mc-container {
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 1024px) {
    .mc-container {
      padding: 0 24px;
    }
  }

  /* Title: text-2xl lg:text-5xl font-bold text-left lg:text-center text-gray-900 mb-4 lg:mb-8 */
  .mc-title {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    text-align: left;
    color: #111827;
    margin-bottom: 16px;
    padding-top: 32px;
  }

  @media (min-width: 1024px) {
    .mc-title {
      font-size: 3rem;
      line-height: 1.1;
      text-align: center;
      margin-bottom: 32px;
    }
  }

  /* Description: text-[20px] font-light text-gray-700 text-left mb-4 lg:mb-8 */
  .mc-description {
    font-size: 20px;
    font-weight: 300;
    color: #374151;
    text-align: left;
    margin-bottom: 16px;
    line-height: 1.6;
    white-space: pre-line;
  }

  @media (min-width: 1024px) {
    .mc-description {
      margin-bottom: 32px;
    }
  }

  /* === SECTION 2: TABLE WRAPPER === */
  
  /* Table Container: bg-[#f5f3f0] rounded-lg overflow-hidden */
  .mc-table {
    background-color: #f5f3f0;
    border-radius: 8px;
    overflow: hidden;
  }

  /* Header Row: hidden lg:grid grid-cols-4 gap-4 px-4 py-4 */
  .mc-table-header {
    display: none;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 16px;
  }

  @media (min-width: 1024px) {
    .mc-table-header {
      display: grid;
    }
  }

  /* Header Text: text-sm font-semibold text-gray-700 text-[24px] */
  .mc-table-header-cell {
    font-size: 24px;
    font-weight: 600;
    color: #374151;
  }

  /* Table Content */
  .mc-table-content {
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* === SECTIONS WITH ACCORDION === */
  
  /* Section Wrapper: my-6 (24px margin) */
  .mc-section-group {
    margin: 24px 0;
  }

  /* Section Header: px-4 py-1 -mx-4 cursor-pointer flex items-center justify-between hover:bg-gray-100/50 */
  .mc-section-header {
    padding: 4px 16px; /* py-1 = 4px, px-4 = 16px */
    margin-left: -16px; /* -mx-4 */
    margin-right: -16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background-color 0.15s;
  }

  .mc-section-header:hover {
    background-color: rgba(243, 244, 246, 0.5); /* hover:bg-gray-100/50 */
  }

  /* Section Title: font-bold uppercase tracking-wide text-[20px] color #F79155 */
  .mc-section-title {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em; /* tracking-wide */
    font-size: 20px;
    color: #F79155;
    margin: 0;
  }

  /* Chevron Icon */
  .mc-chevron {
    width: 20px;
    height: 20px;
    color: #F79155;
    transition: transform 0.3s;
  }

  .mc-chevron.open {
    transform: rotate(180deg);
  }

  /* Section Content (hidden by default, shown when open) */
  .mc-section-content {
    display: none;
  }

  .mc-section-content.open {
    display: block;
  }

  /* === CALCULATOR ROWS - DESKTOP === */
  
  /* Row: hidden lg:grid grid-cols-4 gap-4 py-1 h-[50px] items-center */
  .mc-row {
    display: none;
  }

  @media (min-width: 1024px) {
    .mc-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr); /* grid-cols-4 */
      gap: 16px; /* gap-4 */
      padding: 4px 0; /* py-1 */
      height: 50px; /* h-[50px] */
      align-items: center;
    }
  }

  /* Row Label: font-medium text-gray-900 text-[16px] */
  .mc-row-label {
    font-weight: 500; /* font-medium */
    color: #111827; /* text-gray-900 */
    font-size: 16px; /* text-[16px] */
  }

  /* Sub-category indent: ml-6 with bullet */
  .mc-row-label.sub {
    margin-left: 24px; /* ml-6 */
  }

  .mc-row-label.sub span.bullet {
    margin-right: 8px; /* mr-2 */
  }

  /* Row Description: text-gray-500 text-[16px] */
  .mc-row-desc {
    color: #6b7280; /* text-gray-500 */
    font-size: 16px; /* text-[16px] */
  }

  /* Input: w-full px-3 py-2 bg-white focus:ring-2 focus:ring-orange-400 text-sm text-gray-600 */
  .mc-input {
    width: 100%;
    padding: 8px 12px;
    background-color: white;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    color: #4b5563;
    outline: none;
    transition: all 0.2s;
  }

  .mc-input:focus {
    box-shadow: 0 0 0 2px #fb923c;
  }

  /* Calculated Value: font-medium text-gray-700 */
  .mc-calculated {
    font-weight: 500;
    color: #374151;
  }

  /* Row Note: text-[16px] text-gray-400 */
  .mc-row-note {
    font-size: 16px;
    color: #9ca3af;
    display: flex;
    align-items: center;
  }

  /* Row Cost: text-sm text-gray-600 */
  .mc-row-cost {
    font-size: 14px;
    color: #4b5563;
  }

  /* === CALCULATOR ROWS - MOBILE === */
  
  /* Mobile Row: lg:hidden flex flex-col py-3 border-b border-gray-200/50 */
  .mc-row-mobile {
    display: flex;
    flex-direction: column;
    padding: 12px 0;
    border-bottom: 1px solid rgba(229, 231, 235, 0.5);
  }

  @media (min-width: 1024px) {
    .mc-row-mobile {
      display: none;
    }
  }

  /* Mobile Label: font-medium text-gray-900 text-sm mb-2 */
  .mc-row-mobile-label {
    font-weight: 500;
    color: #111827;
    font-size: 14px;
    margin-bottom: 8px;
  }

  /* Mobile Input Wrapper: flex items-center justify-between gap-4 */
  .mc-row-mobile-input-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Mobile Input */
  .mc-input-mobile {
    flex: 1;
    padding: 10px 12px;
    background-color: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: 14px;
    color: #374151;
    outline: none;
    transition: all 0.2s;
  }

  .mc-input-mobile:focus {
    box-shadow: 0 0 0 2px #fb923c;
    border-color: transparent;
  }

  /* Mobile Calculated Display */
  .mc-calculated-mobile {
    flex: 1;
    padding: 10px 12px;
    background-color: #f3f4f6;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #374151;
  }

  /* Mobile Cost Display: text-sm font-medium text-orange-500 */
  .mc-cost-mobile {
    font-size: 14px;
    font-weight: 500;
    color: #f97316;
    min-width: 80px;
    text-align: right;
  }

  /* Mobile Note */
  .mc-note-mobile {
    font-size: 12px;
    color: #9ca3af;
    font-style: italic;
  }

  /* === DIVIDER === */
  
  /* Divider: h-px bg-black my-6 */
  .mc-divider {
    height: 1px;
    background-color: black;
    margin: 24px 0;
  }

  /* === SUMMARY - DESKTOP === */
  
  /* Desktop Summary: hidden lg:block -mx-4 mt-8 bg-[#f5f3f0] py-6 px-6 text-center */
  .mc-summary-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .mc-summary-desktop {
      display: block;
      margin: 32px -16px 0;
      background-color: #f5f3f0;
      padding: 24px;
      text-align: center;
    }
  }

  /* Summary Title: font-bold text-gray-900 uppercase text-[42px] tracking-wide mb-3 */
  .mc-summary-title {
    font-weight: 700;
    color: #111827;
    text-transform: uppercase;
    font-size: 42px;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  /* Monthly Cost Line: text-gray-800 text-[42px] mb-3 */
  .mc-summary-line {
    color: #1f2937;
    font-size: 42px;
    margin-bottom: 12px;
  }

  /* Monthly Cost Value: text-orange-500 font-bold text-[42px] */
  .mc-summary-value-orange {
    color: #f97316;
    font-weight: 700;
    font-size: 42px;
  }

  /* Glasses Line: text-gray-600 font-bold text-[24px] mb-3 */
  .mc-summary-glasses-line {
    color: #4b5563;
    font-weight: 700;
    font-size: 24px;
    margin-bottom: 12px;
  }

  /* Glasses Value: font-bolder text-gray-900 text-[28px] */
  .mc-summary-glasses-value {
    font-weight: 800;
    color: #111827;
    font-size: 28px;
  }

  /* ROI Value: text-gray-900 font-bold text-[42px] */
  .mc-summary-roi-value {
    color: #111827;
    font-weight: 700;
    font-size: 42px;
  }

  /* === SUMMARY - MOBILE === */
  
  /* Mobile Summary: lg:hidden -mx-4 mt-6 bg-gradient-to-b from-orange-50 to-white py-8 px-4 text-center rounded-t-3xl */
  .mc-summary-mobile {
    display: block;
    margin: 24px -16px 0;
    background: linear-gradient(to bottom, #fff7ed, white);
    padding: 32px 16px;
    text-align: center;
    border-radius: 24px 24px 0 0;
  }

  @media (min-width: 1024px) {
    .mc-summary-mobile {
      display: none;
    }
  }

  /* Mobile Summary Title: font-bold text-gray-900 uppercase text-xl tracking-wide mb-4 */
