<script>
document.addEventListener("DOMContentLoaded", function() {
  // Configuration from Liquid
  const currency = "{{ t_currency }}";
  const glassesPrice = {{ v_glasses_price }};
  const locale = "{{ current_lang | default: 'en' }}";
  
  // Section toggle functionality
  window.toggleSection = function(sectionId) {
    const content = document.getElementById('content-' + sectionId);
    const chevron = document.getElementById('chevron-' + sectionId);
    
    if (content.classList.contains('open')) {
      content.classList.remove('open');
      chevron.classList.remove('open');
    } else {
      content.classList.add('open');
      chevron.classList.add('open');
    }
  };
  
  // Sync desktop and mobile inputs
  function syncInputs(desktopId, mobileId) {
    const desktop = document.getElementById(desktopId);
    const mobile = document.getElementById(mobileId);
    
    if (desktop && mobile) {
      desktop.addEventListener('input', function() {
        mobile.value = this.value;
        recalculate();
      });
      mobile.addEventListener('input', function() {
        desktop.value = this.value;
        recalculate();
      });
    }
  }
  
  // Initialize input sync
  syncInputs('monthlyNetSalary', 'monthlyNetSalaryMobile');
  syncInputs('workDaysPerMonth', 'workDaysPerMonthMobile');
  syncInputs('extraWorkHourlyRate', 'extraWorkHourlyRateMobile');
  syncInputs('extraWorkHoursPerDay', 'extraWorkHoursPerDayMobile');
  syncInputs('lostMonthlyHours', 'lostMonthlyHoursMobile');
  syncInputs('migraineDaysPerMonth', 'migraineDaysPerMonthMobile');
  syncInputs('sickLeaveDays', 'sickLeaveDaysMobile');
  syncInputs('catchUpHours', 'catchUpHoursMobile');
  syncInputs('emergencyExpenses', 'emergencyExpensesMobile');
  syncInputs('foodDelivery', 'foodDeliveryMobile');
  syncInputs('coffee', 'coffeeMobile');
  syncInputs('taxi', 'taxiMobile');
  syncInputs('snacks', 'snacksMobile');
  syncInputs('acuteMedicationCost', 'acuteMedicationCostMobile');
  syncInputs('prophylacticMedicationCost', 'prophylacticMedicationCostMobile');
  syncInputs('doctorVisitCost', 'doctorVisitCostMobile');
  syncInputs('doctorVisitHours', 'doctorVisitHoursMobile');
  syncInputs('travelTimeHours', 'travelTimeHoursMobile');
  syncInputs('lostOpportunitiesCost', 'lostOpportunitiesCostMobile');
  syncInputs('affectedPeopleCount', 'affectedPeopleCountMobile');
  
  // Format currency
  function formatCurrency(value) {
    const formatted = value.toLocaleString(locale === 'pl' ? 'pl-PL' : 'en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
    return formatted + ' ' + currency;
  }
  
  // Get input value
  function getVal(id) {
    const el = document.getElementById(id);
    return el ? parseFloat(el.value) || 0 : 0;
  }
  
  // Set display value
  function setDisplay(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }
  
  // Main calculation function
  function recalculate() {
    // Section 1: Base Data
    const monthlyNetSalary = getVal('monthlyNetSalary');
    const workDaysPerMonth = getVal('workDaysPerMonth');
    
    // Calculate base rates
    const dailyRate = workDaysPerMonth > 0 ? monthlyNetSalary / workDaysPerMonth : 0;
    const hourlyRate = dailyRate / 8;
    
    // Update Section 1 displays
    setDisplay('dailyRateDisplay', formatCurrency(dailyRate));
    setDisplay('dailyRateDisplayMobile', formatCurrency(dailyRate));
    setDisplay('hourlyRateDisplay', formatCurrency(hourlyRate));
    setDisplay('hourlyRateDisplayMobile', formatCurrency(hourlyRate));
    
    // Section 2: Extra Work
    const extraWorkHourlyRate = getVal('extraWorkHourlyRate');
    const lostMonthlyHours = getVal('lostMonthlyHours');
    
    // Section 3: Time & Labor Costs
    const migraineDaysPerMonth = getVal('migraineDaysPerMonth');
    const sickLeaveDays = getVal('sickLeaveDays');
    const catchUpHours = getVal('catchUpHours');
    
    // Calculate Section 3 costs
    const sickLeaveIncomeLoss = dailyRate * 0.2 * sickLeaveDays;
    const extraWorkIncomeLoss = extraWorkHourlyRate * lostMonthlyHours;
    const catchUpTimeCost = catchUpHours * hourlyRate;
    
    // Update Section 3 displays
    setDisplay('sickLeaveIncomeLossDisplay', formatCurrency(sickLeaveIncomeLoss));
    setDisplay('sickLeaveIncomeLossDisplayMobile', formatCurrency(sickLeaveIncomeLoss));
    setDisplay('extraWorkIncomeLossDisplay', formatCurrency(extraWorkIncomeLoss));
    setDisplay('extraWorkIncomeLossDisplayMobile', formatCurrency(extraWorkIncomeLoss));
    setDisplay('catchUpTimeCostDisplay', formatCurrency(catchUpTimeCost));
    setDisplay('catchUpTimeCostDisplayMobile', formatCurrency(catchUpTimeCost));
    
    // Section 4: Direct Expenses
    const emergencyExpenses = getVal('emergencyExpenses');
    const foodDelivery = getVal('foodDelivery');
    const coffee = getVal('coffee');
    const taxi = getVal('taxi');
    const snacks = getVal('snacks');
    const acuteMedicationCost = getVal('acuteMedicationCost');
    const prophylacticMedicationCost = getVal('prophylacticMedicationCost');
    const doctorVisitCost = getVal('doctorVisitCost');
    const doctorVisitHours = getVal('doctorVisitHours');
    const travelTimeHours = getVal('travelTimeHours');
    
    // Calculate Section 4 costs (matching index.liquid formula)
    const totalEmergencyExpenses = emergencyExpenses + foodDelivery + coffee + taxi + snacks + acuteMedicationCost;
    const doctorTimeCost = doctorVisitCost + (doctorVisitHours + travelTimeHours) * hourlyRate;
    
    // Update Section 4 displays
    setDisplay('totalEmergencyExpensesDisplay', formatCurrency(totalEmergencyExpenses));
    setDisplay('totalEmergencyExpensesDisplayMobile', formatCurrency(totalEmergencyExpenses));
    setDisplay('doctorTimeCostDisplay', formatCurrency(doctorTimeCost));
    setDisplay('doctorTimeCostDisplayMobile', formatCurrency(doctorTimeCost));
    
    // Section 5: Emotional Costs
    const lostOpportunitiesCost = getVal('lostOpportunitiesCost');
    
    // Update Section 5 displays
    setDisplay('lostOpportunitiesCostDisplay', formatCurrency(lostOpportunitiesCost));
    setDisplay('lostOpportunitiesCostDisplayMobile', formatCurrency(lostOpportunitiesCost));
    
    // Calculate total monthly cost (matching index.liquid formula)
    const totalMonthlyCost = sickLeaveIncomeLoss + extraWorkIncomeLoss + catchUpTimeCost +
      (totalEmergencyExpenses * migraineDaysPerMonth) + prophylacticMedicationCost + doctorTimeCost;
    
    // Calculate ROI
    const costPerMigraineDay = migraineDaysPerMonth > 0 ? totalMonthlyCost / migraineDaysPerMonth : 0;
    const breakEvenDays = costPerMigraineDay > 0 ? Math.round(glassesPrice / costPerMigraineDay) : 0;
    
    // Update Summary displays
    setDisplay('totalMonthlyCostDisplay', formatCurrency(totalMonthlyCost));
    setDisplay('totalMonthlyCostDisplayMobile', formatCurrency(totalMonthlyCost));
    setDisplay('breakEvenDaysDisplay', breakEvenDays);
    setDisplay('breakEvenDaysDisplayMobile', breakEvenDays + ' {{ t_days }}');
  }
  
  // Add event listeners to all inputs
  document.querySelectorAll('#migraine-calculator input[type="number"]').forEach(function(input) {
    input.addEventListener('input', recalculate);
  });
  
  // Initial calculation
  recalculate();
});
</script>
