{% style %}
  /* --- Synced with MigraineCostCalculator.tsx --- */
  
  /* Font Family: system sans-serif stack (matches Tailwind's font-sans) */
  #migraine-calculator-wrapper {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background-color: #f5f3f0;
    color: #1a1a1a;
    line-height: 1.5;
    width: 100%;
    display: block;
    font-size: 16px;
  }

  #migraine-calculator-wrapper * { box-sizing: border-box; }

  .calculator-section {
    padding: 48px 16px;
    max-width: 1000px; /* Contained width for better readability */
    margin: 0 auto; /* Center the content */
  }

  @media (min-width: 1024px) {
    .calculator-section {
      padding: 80px 40px;
    }
  }

  /* --- TITLE: text-2xl lg:text-5xl font-bold text-left lg:text-center --- */
  .calculator-title {
    font-size: 1.5rem;
    font-weight: 700;
    text-align: left;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  @media (min-width: 1024px) {
    .calculator-title {
      font-size: 2.5rem;
      text-align: left;
      margin-bottom: 24px;
    }
  }

  /* --- DESCRIPTION: text-[20px] font-light text-gray-700 text-left --- */
  .calculator-description {
    font-size: 16px;
    font-weight: 300;
    text-align: left;
    color: #374151;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .calculator-description {
      font-size: 18px;
      margin-bottom: 40px;
    }
  }

  .calculator-table {
    background-color: #f5f3f0;
    border-radius: 8px;
    overflow: hidden;
  }

  /* --- TABLE HEADER --- */
  .table-header {
    display: none;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #e5e7eb;
  }

  @media (min-width: 1024px) {
    .table-header { display: grid; }
  }

  .table-header div {
    font-size: 14px;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .table-content { padding: 0; }

  /* --- SECTION HEADER --- */
  .section-wrapper {
    margin: 16px 0;
  }

  .section-header {
    padding: 8px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background-color 0.15s;
    border-bottom: 2px solid #F79155;
    margin-bottom: 8px;
  }

  .section-header:hover {
    background-color: rgba(243, 244, 246, 0.5);
  }

  .section-header h3 {
    font-weight: 700;
    color: #F79155;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.08em;
    margin: 0;
  }

  /* --- DESKTOP ROWS --- */
  .calc-row {
    display: none;
  }

  @media (min-width: 1024px) {
    .calc-row {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 12px;
      padding: 8px 0;
      min-height: 44px;
      align-items: center;
      border-bottom: 1px solid #f3f4f6;
    }
  }

  /* --- MOBILE ROW: lg:hidden flex flex-col py-3 border-b --- */
  .calc-row-mobile {
    display: flex;
    flex-direction: column;
    padding: 12px 0; /* py-3 */
    border-bottom: 1px solid rgba(229, 231, 235, 0.5); /* border-gray-200/50 */
  }

  @media (min-width: 1024px) {
    .calc-row-mobile { display: none; }
  }

  .calc-row-mobile .row-label {
    font-size: 14px; /* text-sm */
    margin-bottom: 8px; /* mb-2 */
  }

  .calc-row-mobile .input-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .calc-row-mobile input[type="number"] {
    flex: 1;
    padding: 10px 12px; /* py-2.5 px-3 */
    background-color: white;
    border: 1px solid #e5e7eb; /* border-gray-200 */
    border-radius: 8px; /* rounded-lg */
  }

  .calc-row-mobile .cost-display {
    font-size: 14px;
    font-weight: 500;
    color: #f97316; /* text-orange-500 */
    min-width: 80px;
    text-align: right;
  }

  /* --- ROW LABEL: text-[16px] font-medium text-gray-900 --- */
  .row-label {
    font-weight: 500;
    color: #1a1a1a;
    font-size: 16px;
  }

  /* --- ROW DESC --- */
  .row-desc {
    display: none;
    font-size: 13px;
    color: #6b7280;
  }

  @media (min-width: 1024px) {
    .row-desc { display: block; }
  }

  /* --- ROW NOTE --- */
  .row-note {
    font-size: 13px;
    color: #9ca3af;
    display: flex;
    align-items: center;
  }

  /* --- INPUT: text-sm text-gray-600 --- */
  #migraine-calculator-wrapper input[type="number"] {
    width: 100%;
    padding: 8px 12px;
    background-color: white;
    border: 1px solid transparent;
    border-radius: 4px;
    font-size: 14px; /* text-sm */
    color: #4b5563; /* text-gray-600 */
    outline: none;
    transition: all 0.2s;
    height: auto;
    margin: 0;
  }

  #migraine-calculator-wrapper input[type="number"]:focus {
    box-shadow: 0 0 0 2px #fb923c; /* focus:ring-2 focus:ring-orange-400 */
  }

  .calculated-value {
    font-weight: 500;
    color: #374151;
    font-size: 16px;
  }

  .row-cost {
    font-size: 14px;
    color: #4b5563;
  }

  .calc-divider {
    height: 1px;
    background-color: #000;
    margin: 24px 0; /* my-6 */
    width: 100%;
  }

  /* --- DESKTOP SUMMARY --- */
  .summary-section-desktop {
    display: none;
    margin: 32px 0;
    background-color: #f5f3f0;
    padding: 32px;
    text-align: center;
    border-top: 2px solid #e5e7eb;
  }

  @media (min-width: 1024px) {
    .summary-section-desktop { display: block; }
  }

  .summary-title {
    font-weight: 700;
    color: #1a1a1a;
    text-transform: uppercase;
    font-size: 18px;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .summary-cost-line {
    color: #1f2937;
    font-size: 16px;
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .summary-cost-value {
    color: #f97316;
    font-weight: 700;
    font-size: 28px;
    display: block;
    margin-top: 4px;
  }

  .summary-glasses-line {
    color: #4b5563;
    font-weight: 500;
    font-size: 14px;
    margin-bottom: 16px;
  }

  .summary-glasses-value {
    font-weight: 700;
    color: #1a1a1a;
    font-size: 16px;
  }

  .summary-roi-line {
    color: #1f2937;
    font-size: 16px;
  }

  .summary-roi-value {
    color: #1a1a1a;
    font-weight: 700;
    font-size: 24px;
    display: block;
    margin-top: 4px;
  }

  /* --- MOBILE SUMMARY: lg:hidden card-based design --- */
  .summary-section-mobile {
    display: block;
    margin: 24px -16px 0 -16px;
    background: linear-gradient(to bottom, #fff7ed, white); /* from-orange-50 to-white */
    padding: 32px 16px;
    text-align: center;
    border-radius: 24px 24px 0 0;
  }

  @media (min-width: 1024px) {
    .summary-section-mobile { display: none; }
  }

  .summary-section-mobile .summary-title-mobile {
    font-weight: 700;
    color: #1a1a1a;
    text-transform: uppercase;
    font-size: 20px; /* text-xl */
    letter-spacing: 0.05em;
    margin-bottom: 16px;
  }

  .summary-card {
    background-color: white;
    border-radius: 16px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    padding: 20px;
    margin-bottom: 16px;
  }

  .summary-card-gray {
    background-color: #f3f4f6;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .summary-card p.label {
    font-size: 14px;
    color: #4b5563;
    margin-bottom: 4px;
  }

  .summary-card p.value-orange {
    font-size: 30px; /* text-3xl */
    font-weight: 700;
    color: #f97316;
  }

  .summary-card-gray p.label {
    font-size: 14px;
    color: #4b5563;
  }

  .summary-card-gray p.value {
    font-size: 20px; /* text-xl */
    font-weight: 700;
    color: #1a1a1a;
  }

  .summary-card p.value-dark {
    font-size: 24px; /* text-2xl */
    font-weight: 700;
    color: #1a1a1a;
  }

  .desktop-only { display: none; }
  @media (min-width: 1024px) { .desktop-only { display: block; } }
{% endstyle %}


<div id="migraine-calculator-wrapper">
  <section class="calculator-section">
      <h2 class="calculator-title">{{ t_title }}</h2>
      <p class="calculator-description">{{ t_description }}</p>

      <div class="calculator-table">
          <div class="table-header">
              <div>{{ t_col_desc }}</div>
              <div>{{ t_col_note }}</div>
              <div>{{ t_col_val }}</div>
              <div>{{ t_col_cost }} ({{ t_currency_iso }})</div>
          </div>

          <div class="table-content">
              <div class="section-header first">
                  <h3>{{ t_sec_base }}</h3>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_salary }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="monthlyNetSalary" value="{{ v_def_salary }}" placeholder="{{ t_col_val }}"></div>
                  <div class="desktop-only"></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_work_days }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="workDaysPerMonth" value="20" placeholder="{{ t_col_val }}"></div>
                  <div class="row-note">{{ t_desc_std }}</div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_daily_rate }}</div>
                  <div></div>
                  <div class="calculated-value" id="dailyRateDisplay">--</div>
                  <div class="row-note">{{ t_desc_auto }}</div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_hourly_rate }}</div>
                  <div></div>
                  <div class="calculated-value" id="hourlyRateDisplay">--</div>
                  <div class="row-note">{{ t_desc_auto }}</div>
              </div>

              <div class="section-header">
                  <h3>{{ t_sec_extra }}</h3>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_extra_rate }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="extraWorkHourlyRate" value="{{ v_def_hourly }}" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_extra_hours }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="extraWorkHoursPerDay" value="4" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_lost_hours }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="lostMonthlyHours" value="0" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="section-header">
                  <h3>{{ t_sec_time }}</h3>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_migraine_days }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="migraineDaysPerMonth" value="4" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_sick_leave }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="sickLeaveDays" value="1" placeholder="{{ t_col_val }}"></div>
                  <div class="row-cost" id="sickLeaveIncomeLossDisplay">0</div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_income_loss_extra }}</div>
                  <div></div>
                  <div class="calculated-value" id="extraWorkIncomeLossDisplay">0</div>
                  <div class="row-note"></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_catchup_hours }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="catchUpHours" value="0" placeholder="{{ t_col_val }}"></div>
                  <div class="row-cost" id="catchUpTimeCostDisplay">0</div>
              </div>

              <div class="section-header">
                  <h3>{{ t_sec_direct }}</h3>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_emergency }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="emergencyExpenses" value="{{ v_def_emergency }}" placeholder="{{ t_col_val }}"></div>
                  <div class="row-cost" id="totalEmergencyExpensesDisplay">0</div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_food }}</div>
                  <div></div>
                  <div><input type="number" id="foodDelivery" value="0" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_coffee }}</div>
                  <div></div>
                  <div><input type="number" id="coffee" value="0" placeholder="{{ t_col_val }}"></div>
