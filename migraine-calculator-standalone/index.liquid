              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_snacks }}</div>
                  <div></div>
                  <div><input type="number" id="snacks" value="0" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_meds_acute }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="acuteMedicationCost" value="0" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_meds_pro }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="prophylacticMedicationCost" value="0" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_doctor_cost }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="doctorVisitCost" value="{{ v_def_doctor_cost }}" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_doctor_hours }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="doctorVisitHours" value="2" placeholder="{{ t_col_val }}"></div>
                  <div class="row-cost" id="doctorTimeCostDisplay">--</div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_travel_hours }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="travelTimeHours" value="0" placeholder="{{ t_col_val }}"></div>
                  <div></div>
              </div>

              <div class="section-header">
                  <h3>{{ t_sec_emotional }}</h3>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_opp_cost }} ({{ t_currency_iso }})</div>
                  <div class="row-desc">{{ t_desc_opp }}</div>
                  <div><input type="number" id="lostOpportunitiesCost" value="0" placeholder="{{ t_col_val }}"></div>
                  <div class="row-cost" id="lostOpportunitiesCostDisplay">0</div>
              </div>

              <div class="calc-row">
                  <div class="row-label">{{ t_affected_people }}</div>
                  <div class="row-desc">{{ t_desc_enter }}</div>
                  <div><input type="number" id="affectedPeopleCount" value="0" placeholder="{{ t_col_val }}"></div>
                  <div class="row-note">{{ t_desc_info }}</div>
              </div>

              <div class="calc-divider"></div>

              <!-- DESKTOP SUMMARY -->
              <div class="summary-section-desktop">
                  <h3 class="summary-title">{{ t_sec_summary }}</h3>
                  
                  <p class="summary-cost-line">
                      {{ t_summary_line_1 }} 
                      <span class="summary-cost-value" id="totalMonthlyCostDisplay">0</span>
                  </p>
                  
                  <p class="summary-glasses-line">
                      {{ t_summary_line_2 }} 
                      <span class="summary-glasses-value" id="glassesPriceDisplay">--</span>
                  </p>
                  
                  <p class="summary-roi-line">
                      {{ t_summary_line_3 }} 
                      <span class="summary-roi-value" id="breakEvenDaysDisplay">0</span> {{ t_days }}
                  </p>
              </div>

              <!-- MOBILE SUMMARY -->
              <div class="summary-section-mobile">
                  <h3 class="summary-title-mobile">{{ t_sec_summary }}</h3>
                  
                  <div class="summary-card">
                      <p class="label">{{ t_summary_line_1 }}</p>
                      <p class="value-orange" id="totalMonthlyCostDisplayMobile">0</p>
                  </div>
                  
                  <div class="summary-card-gray">
                      <p class="label">{{ t_summary_line_2 }}</p>
                      <p class="value" id="glassesPriceDisplayMobile">--</p>
                  </div>
                  
                  <div class="summary-card">
                      <p class="label">{{ t_summary_line_3 }}</p>
                      <p class="value-dark" id="breakEvenDaysDisplayMobile">0</p>
                  </div>
              </div>
          </div>
      </div>
  </section>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
      // DATA FROM LIQUID
      const currencyIso = "{{ t_currency_iso }}";
      const userLocale = "{{ request.locale.iso_code }}";
      const glassesPrice = Number("{{ v_glasses_price }}"); 
      
      // DOM ELEMENTS
      const inputs = {
          monthlyNetSalary: document.getElementById('monthlyNetSalary'),
          workDaysPerMonth: document.getElementById('workDaysPerMonth'),
          extraWorkHourlyRate: document.getElementById('extraWorkHourlyRate'),
          extraWorkHoursPerDay: document.getElementById('extraWorkHoursPerDay'),
          lostMonthlyHours: document.getElementById('lostMonthlyHours'),
          migraineDaysPerMonth: document.getElementById('migraineDaysPerMonth'),
          sickLeaveDays: document.getElementById('sickLeaveDays'),
          catchUpHours: document.getElementById('catchUpHours'),
          emergencyExpenses: document.getElementById('emergencyExpenses'),
          foodDelivery: document.getElementById('foodDelivery'),
          coffee: document.getElementById('coffee'),
          taxi: document.getElementById('taxi'),
          snacks: document.getElementById('snacks'),
          acuteMedicationCost: document.getElementById('acuteMedicationCost'),
          prophylacticMedicationCost: document.getElementById('prophylacticMedicationCost'),
          doctorVisitCost: document.getElementById('doctorVisitCost'),
          doctorVisitHours: document.getElementById('doctorVisitHours'),
          travelTimeHours: document.getElementById('travelTimeHours'),
          lostOpportunitiesCost: document.getElementById('lostOpportunitiesCost'),
          affectedPeopleCount: document.getElementById('affectedPeopleCount')
      };

      const displays = {
          dailyRate: document.getElementById('dailyRateDisplay'),
          hourlyRate: document.getElementById('hourlyRateDisplay'),
          sickLeaveIncomeLoss: document.getElementById('sickLeaveIncomeLossDisplay'),
          extraWorkIncomeLoss: document.getElementById('extraWorkIncomeLossDisplay'),
          catchUpTimeCost: document.getElementById('catchUpTimeCostDisplay'),
          totalEmergencyExpenses: document.getElementById('totalEmergencyExpensesDisplay'),
          doctorTimeCost: document.getElementById('doctorTimeCostDisplay'),
          lostOpportunitiesCostDisplay: document.getElementById('lostOpportunitiesCostDisplay'),
          totalMonthlyCost: document.getElementById('totalMonthlyCostDisplay'),
          breakEvenDays: document.getElementById('breakEvenDaysDisplay'),
          glassesPriceDisplay: document.getElementById('glassesPriceDisplay'),
          // Mobile displays
          totalMonthlyCostMobile: document.getElementById('totalMonthlyCostDisplayMobile'),
          glassesPriceDisplayMobile: document.getElementById('glassesPriceDisplayMobile'),
          breakEvenDaysMobile: document.getElementById('breakEvenDaysDisplayMobile')
      };

      // CURRENCY FORMATTER
      function formatCurrency(value) {
          const localeStr = userLocale === 'pl' ? 'pl-PL' : 'en-IE';
          return new Intl.NumberFormat(localeStr, {
              style: 'currency',
              currency: currencyIso,
          }).format(value);
      }

      function getValue(input) {
          if(!input) return 0;
          return parseFloat(input.value) || 0;
      }

      function calculate() {
          const monthlyNetSalary = getValue(inputs.monthlyNetSalary);
          const workDaysPerMonth = getValue(inputs.workDaysPerMonth);
          const extraWorkHourlyRate = getValue(inputs.extraWorkHourlyRate);
          const lostMonthlyHours = getValue(inputs.lostMonthlyHours);
          const migraineDaysPerMonth = getValue(inputs.migraineDaysPerMonth);
          const sickLeaveDays = getValue(inputs.sickLeaveDays);
          const catchUpHours = getValue(inputs.catchUpHours);
          const emergencyExpenses = getValue(inputs.emergencyExpenses);
          const foodDelivery = getValue(inputs.foodDelivery);
          const coffee = getValue(inputs.coffee);
          const taxi = getValue(inputs.taxi);
          const snacks = getValue(inputs.snacks);
          const acuteMedicationCost = getValue(inputs.acuteMedicationCost);
          const prophylacticMedicationCost = getValue(inputs.prophylacticMedicationCost);
          const doctorVisitCost = getValue(inputs.doctorVisitCost);
          const doctorVisitHours = getValue(inputs.doctorVisitHours);
          const travelTimeHours = getValue(inputs.travelTimeHours);
          const lostOpportunitiesCost = getValue(inputs.lostOpportunitiesCost);

          const dailyRate = workDaysPerMonth === 0 ? 0 : monthlyNetSalary / workDaysPerMonth;
          const hourlyRate = dailyRate / 8;
          const sickLeaveIncomeLoss = dailyRate * 0.2 * sickLeaveDays;
          const extraWorkIncomeLoss = extraWorkHourlyRate * lostMonthlyHours;
          const catchUpTimeCost = catchUpHours * hourlyRate;
          const totalEmergencyExpenses = emergencyExpenses + foodDelivery + coffee + taxi + snacks + acuteMedicationCost;
          const doctorTimeCost = doctorVisitCost + (doctorVisitHours + travelTimeHours) * hourlyRate;

          const totalMonthlyCost = sickLeaveIncomeLoss + extraWorkIncomeLoss + catchUpTimeCost +
              (totalEmergencyExpenses * migraineDaysPerMonth) + prophylacticMedicationCost + doctorTimeCost;

          const costPerMigraineDay = migraineDaysPerMonth === 0 ? 0 : totalMonthlyCost / migraineDaysPerMonth;
          const breakEvenDays = costPerMigraineDay === 0 ? 0 : glassesPrice / costPerMigraineDay;

          // Update Desktop Displays
          if(displays.dailyRate) displays.dailyRate.textContent = formatCurrency(dailyRate);
          if(displays.hourlyRate) displays.hourlyRate.textContent = formatCurrency(hourlyRate);
          if(displays.sickLeaveIncomeLoss) displays.sickLeaveIncomeLoss.textContent = formatCurrency(sickLeaveIncomeLoss);
          if(displays.extraWorkIncomeLoss) displays.extraWorkIncomeLoss.textContent = formatCurrency(extraWorkIncomeLoss);
          if(displays.catchUpTimeCost) displays.catchUpTimeCost.textContent = formatCurrency(catchUpTimeCost);
          if(displays.totalEmergencyExpenses) displays.totalEmergencyExpenses.textContent = formatCurrency(totalEmergencyExpenses);
          if(displays.doctorTimeCost) displays.doctorTimeCost.textContent = formatCurrency(doctorTimeCost);
          if(displays.lostOpportunitiesCostDisplay) displays.lostOpportunitiesCostDisplay.textContent = formatCurrency(lostOpportunitiesCost);
          
          if(displays.totalMonthlyCost) displays.totalMonthlyCost.textContent = formatCurrency(totalMonthlyCost);
          if(displays.glassesPriceDisplay) displays.glassesPriceDisplay.textContent = formatCurrency(glassesPrice);
          if(displays.breakEvenDays) displays.breakEvenDays.textContent = Math.round(breakEvenDays);
          
          // Update Mobile Displays
          if(displays.totalMonthlyCostMobile) displays.totalMonthlyCostMobile.textContent = formatCurrency(totalMonthlyCost);
          if(displays.glassesPriceDisplayMobile) displays.glassesPriceDisplayMobile.textContent = formatCurrency(glassesPrice);
          if(displays.breakEvenDaysMobile) displays.breakEvenDaysMobile.textContent = Math.round(breakEvenDays) + ' {{ t_days }}';
      }

      Object.values(inputs).forEach(input => {
          if(input) { input.addEventListener('input', calculate); }
      });

      calculate();
  });
</script>

